SEC_USER_AGENT="Your Name your.email@example.com"
SEC_API_KEY=""

# Local Docker PostgreSQL; extraction commands also save XBRL exports here.
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="sec"
POSTGRES_PASSWORD="sec_local_pw"
POSTGRES_DB="sec_disclosure"
# DATABASE_URL can override the connection settings above.

# SoCLaaS settings normally live in ~/.config/soclaas/soclaas.env.
# The LLM client loads that file automatically; this file is only a template.
SOCLAAS_BASE_URL="https://soclaas-api.comp.nus.edu.sg/v1"
SOCLAAS_API_KEY=""
SOCLAAS_MODEL="default"
