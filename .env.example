SEC_USER_AGENT="Your Name your.email@example.com"
SEC_API_KEY=""
# Alternatively, use scripts/run_with_gcp_secrets.py to load API settings
# from Google Secret Manager. Its non-secret identifiers are in gcp-secrets.json.

# Local Docker PostgreSQL; extraction commands also save XBRL exports here.
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5432"
POSTGRES_USER="sec"
POSTGRES_PASSWORD="sec_local_pw"
POSTGRES_DB="sec_disclosure"
# DATABASE_URL can override the connection settings above.

# SoCLaaS settings can come from the cloud launcher, this file, or
# ~/.config/soclaas/soclaas.env. Exported settings take priority.
SOCLAAS_BASE_URL="https://soclaas-api.comp.nus.edu.sg/v1"
SOCLAAS_API_KEY=""
SOCLAAS_MODEL="default"
